<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/view_barra" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textoIncDetId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Etiqueta"
                            tools:text="INC-2026-014" />

                        <TextView
                            android:id="@+id/etiquetaIncDetEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            style="@style/Etiqueta"
                            tools:text="ABIERTO" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textoIncDetTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/Texto.Titulo"
                        tools:text="Título" />

                    <TextView
                        android:id="@+id/etiquetaIncDetSeveridad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        style="@style/Etiqueta"
                        tools:text="CRÍTICA" />

                    <TextView
                        android:id="@+id/textoIncDetDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        style="@style/Texto.Cuerpo"
                        tools:text="Descripción" />

                    <TextView
                        android:id="@+id/textoIncDetSector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        style="@style/Texto.Secundario"
                        tools:text="Sector" />

                    <TextView
                        android:id="@+id/textoIncDetFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Texto.Secundario"
                        tools:text="Fecha" />

                    <TextView
                        android:id="@+id/textoIncDetReportado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Texto.Secundario"
                        tools:text="Reportado por" />

                    <TextView
                        android:id="@+id/textoIncDetResponsable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Texto.Secundario"
                        tools:text="Responsable" />

                    <TextView
                        android:id="@+id/textoIncDetPersonas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Texto.Secundario"
                        tools:text="Personas afectadas" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/incidente_acciones"
                style="@style/Texto.Seccion" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:contentPadding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/contenedorAcciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/textoSinAcciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/incidente_sin_acciones"
                        android:visibility="gone"
                        style="@style/Texto.Secundario" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonAgregarAccion"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/incidente_nueva_accion"
                app:icon="@drawable/ic_agregar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCerrarIncidente"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/incidente_cerrar"
                android:textStyle="bold"
                app:icon="@drawable/ic_check" />

            <TextView
                android:id="@+id/textoAvisoCierre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/incidente_no_cerrable"
                android:visibility="gone"
                style="@style/Texto.Secundario" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
