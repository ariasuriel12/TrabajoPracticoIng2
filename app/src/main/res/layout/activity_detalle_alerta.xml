<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/view_barra" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/avisoRespuestaInmediata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/estado_critico_suave"
                android:padding="14dp"
                android:textColor="@color/estado_critico"
                android:textStyle="bold"
                android:visibility="gone"
                style="@style/Texto.Cuerpo"
                tools:text="Requiere respuesta inmediata" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/etiquetaDetalleSeveridad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        style="@style/Etiqueta"
                        tools:text="CRÍTICA" />

                    <TextView
                        android:id="@+id/textoDetalleTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        style="@style/Texto.Titulo"
                        tools:text="Título" />

                    <TextView
                        android:id="@+id/textoDetalleDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        style="@style/Texto.Cuerpo"
                        tools:text="Descripción" />

                    <TextView
                        android:id="@+id/textoDetalleSector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        style="@style/Texto.Secundario"
                        tools:text="Sector" />

                    <TextView
                        android:id="@+id/textoDetalleTipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Texto.Secundario"
                        tools:text="Tipo" />

                    <TextView
                        android:id="@+id/textoDetalleTiempo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Texto.Secundario"
                        tools:text="Hace" />

                    <TextView
                        android:id="@+id/textoDetalleEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        style="@style/Texto.Cuerpo"
                        tools:text="Estado" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonReconocer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/alerta_reconocer"
                android:textStyle="bold"
                app:icon="@drawable/ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGenerarIncidente"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/alerta_generar_incidente"
                app:icon="@drawable/ic_incidente" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonVerSector"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sector_detalle"
                app:icon="@drawable/ic_sector" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
