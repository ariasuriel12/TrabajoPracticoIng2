<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SeguridadApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrabajoPracticoIng2"
        tools:targetApi="31">

        <!-- Pantalla inicial: identifica al usuario y su perfil de acceso -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Contenedor de la navegación principal (tablero, alertas, incidentes, tareas, más) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Alertas -->
        <activity
            android:name=".ui.alertas.DetalleAlertaActivity"
            android:exported="false" />

        <!-- Incidentes -->
        <activity
            android:name=".ui.incidentes.DetalleIncidenteActivity"
            android:exported="false" />
        <activity
            android:name=".ui.incidentes.NuevoIncidenteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.incidentes.NuevaAccionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tareas -->
        <activity
            android:name=".ui.tareas.NuevaTareaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Procedimientos y cumplimiento -->
        <activity
            android:name=".ui.procedimientos.ProcedimientosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.procedimientos.DetalleProcedimientoActivity"
            android:exported="false" />

        <!-- Sectores de planta -->
        <activity
            android:name=".ui.sectores.SectoresActivity"
            android:exported="false" />
        <activity
            android:name=".ui.sectores.DetalleSectorActivity"
            android:exported="false" />

        <!-- Auditoría y trazabilidad -->
        <activity
            android:name=".ui.auditoria.AuditoriaActivity"
            android:exported="false" />

        <!-- Perfil y permisos -->
        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false" />

        <!-- Modo emergencia (situación crítica) -->
        <activity
            android:name=".ui.emergencia.EmergenciaActivity"
            android:exported="false" />

    </application>

</manifest>
